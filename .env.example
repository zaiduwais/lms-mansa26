# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ==============================================================================
# LMS MADRASAH ALIYAH - FASE 2 ENVIRONTMENT CONFIGURATION
# ==============================================================================

# BOOTSTRAP_ADMIN: Kredensial untuk inisialisasi akun Administrator pertama kali.
# Jalur ini otomatis ditutup begitu akun admin pertama telah dibuat di Firestore.
BOOTSTRAP_ADMIN_ID="198005122005011002"
BOOTSTRAP_ADMIN_PASSWORD="MadrasahCinta#2026"
BOOTSTRAP_ADMIN_NAMA="H. Ahmad Fauzi, M.Pd."

# LMS_AUTH_DOMAIN: Domain sintetis internal untuk mapping NISN/NIP ke Firebase Auth
# Pengguna hanya memasukkan NISN/NIP dan tidak pernah melihat email ini.
LMS_AUTH_DOMAIN="lms.madrasah.id"

# FIREBASE_SERVICE_ACCOUNT_KEY: (Opsional) Kunci privat service account (JSON)
# Jika dideploy di Google Cloud Run / AI Studio, runtime menggunakan Application Default Credentials (ADC).
FIREBASE_SERVICE_ACCOUNT_KEY=""
